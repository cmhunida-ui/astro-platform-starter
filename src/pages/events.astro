  <!-- 페이지 번호 -->

  <div class="pagination">
    <button class="page-button active" data-page-button="1">1</button>
    <button class="page-button" data-page-button="2">2</button>
    <button class="page-button" data-page-button="3">3</button>
    <button class="page-button" data-page-button="4">4</button>
  </div>

</div>


<script>
  const eventItems = document.querySelectorAll('.event[data-page]');
  const pageButtons = document.querySelectorAll('.page-button');

  function showPage(page) {

    eventItems.forEach((event) => {
      const eventPage = event.getAttribute('data-page');

      if (eventPage === page) {
        event.style.display = 'flex';
      } else {
        event.style.display = 'none';
      }
    });

    pageButtons.forEach((button) => {
      if (button.getAttribute('data-page-button') === page) {
        button.classList.add('active');
      } else {
        button.classList.remove('active');
      }
    });
  }

  pageButtons.forEach((button) => {
    button.addEventListener('click', () => {

      const page = button.getAttribute('data-page-button');

      showPage(page);

      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });

    });
  });

  showPage('1');
</script>

</Layout>
