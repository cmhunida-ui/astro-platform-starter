const itemsPerPage = 5;
---

<Layout title="Events">

<style>
  .container {
    max-width: 1000px;
    margin: 80px auto;
    padding: 0 20px;
    color: #ddd;
  }

  h1 {
    font-size: 28px;
    margin-bottom: 50px;
  }

  .event {
    display: flex;
    gap: 30px;
    margin-bottom: 70px;
    align-items: flex-start;
  }

  .event-image {
    width: 200px;
    height: 280px;
    flex-shrink: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .event img {
    width: 200px;
    height: 280px;
    object-fit: contain;
    display: block;
  }

  .info {
    font-size: 16px;
    line-height: 1.9;
  }

  .title {
    font-size: 18px;
    margin-bottom: 10px;
  }

  .work {
    margin-bottom: 10px;
  }

  .date {
    margin-bottom: 6px;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-top: 30px;
    margin-bottom: 60px;
  }

  .pagination a {
    color: #ddd;
    text-decoration: none;
    font-size: 16px;
  }

  .pagination a:hover {
    opacity: 0.6;
  }

  .pagination .active {
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .event {
      flex-direction: column;
    }

    .event-image {
      width: 100%;
      height: auto;
      justify-content: flex-start;
    }

    .event img {
      width: 100%;
      max-width: 300px;
      height: 400px;
    }
  }
</style>

<div class="container">

  <h1>EVENTS</h1>

  <div id="events-container"></div>

  <div class="pagination">
    <a href="/events?page=1" data-page="1">1</a>
    <a href="/events?page=2" data-page="2">2</a>
    <a href="/events?page=3" data-page="3">3</a>
    <a href="/events?page=4" data-page="4">4</a>
  </div>

</div>

<script define:vars={{ events, itemsPerPage }}>
  const params = new URLSearchParams(window.location.search);
  const currentPage = Number(params.get("page")) || 1;

  const start = (currentPage - 1) * itemsPerPage;
  const currentEvents = events.slice(start, start + itemsPerPage);

  const container = document.getElementById("events-container");

  if (container) {
    container.innerHTML = currentEvents.map((event) => `
      <div class="event">

        <div class="event-image">
          <img src="${event.image}" alt="${event.title}">
        </div>

        <div class="info">

          <div class="title">
            ${event.title}
          </div>

          ${
            event.work
              ? `<div class="work">${event.work}</div>`
              : ""
          }

          <div class="date">
            ${event.date}
          </div>

          <div>
            ${event.place}
          </div>

          <div>
            ${event.performers}
          </div>

        </div>

      </div>
    `).join("");
  }

  document.querySelectorAll(".pagination a").forEach((link) => {
    if (Number(link.dataset.page) === currentPage) {
      link.classList.add("active");
    }
  });
</script>

</Layout>
