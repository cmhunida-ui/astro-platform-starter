---

<Layout title="Events">

<style>
  .container {
    max-width: 1000px;
    margin: 80px auto;
    padding: 0 20px;
    color: #ddd;
  }

  h1 {
    font-size: 28px;
    margin-bottom: 50px;
  }

  .event {
    display: flex;
    gap: 30px;
    margin-bottom: 70px;
    align-items: flex-start;
  }

  .event img {
    width: 200px;
    height: auto;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  .info {
    font-size: 16px;
    line-height: 1.9;
  }

  .title {
    font-size: 18px;
    margin-bottom: 10px;
  }

  .work {
    margin-bottom: 10px;
  }

  .date {
    margin-bottom: 6px;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
    padding-bottom: 60px;
  }

  .pagination button {
    background: none;
    border: none;
    color: white;
    font-size: 16px;
    cursor: pointer;
    padding: 8px 10px;
    opacity: 0.6;
  }

  .pagination button:hover {
    opacity: 1;
  }

  .pagination button.active {
    opacity: 1;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .container {
      margin: 50px auto;
      padding: 0 20px;
    }

    h1 {
      font-size: 26px;
      margin-bottom: 40px;
    }

    .event {
      flex-direction: column;
      gap: 20px;
      margin-bottom: 60px;
    }

    .event img {
      width: 100%;
      max-width: 400px;
    }

    .info {
      font-size: 15px;
    }

    .title {
      font-size: 18px;
    }
  }
</style>

<div class="container">

  <h1>EVENTS</h1>

  <div id="events-list"></div>

  <div class="pagination" id="pagination"></div>

</div>

<script define:vars={{ events }}>
  const itemsPerPage = 5;
  let currentPage = 1;

  const eventsList = document.getElementById("events-list");
  const pagination = document.getElementById("pagination");

  function renderEvents() {
    if (!eventsList || !pagination) return;

    const totalPages = Math.ceil(events.length / itemsPerPage);

    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;

    const currentEvents = events.slice(start, end);

    eventsList.innerHTML = currentEvents.map((event) => `
      <div class="event">

        <img src="${event.image}" alt="${event.title}">

        <div class="info">

          <div class="title">
            ${event.title}
          </div>

          ${
            event.work
              ? `<div class="work">${event.work}</div>`
              : ""
          }

          <div class="date">
            ${event.date}
          </div>

          <div>
            ${event.place}
          </div>

          <div>
            ${event.performers}
          </div>

        </div>

      </div>
    `).join("");

    pagination.innerHTML = "";

    for (let page = 1; page <= totalPages; page++) {
      const button = document.createElement("button");

      button.textContent = page;

      if (page === currentPage) {
        button.classList.add("active");
      }

      button.addEventListener("click", () => {
        currentPage = page;
        renderEvents();

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });
      });

      pagination.appendChild(button);
    }
  }

  renderEvents();
</script>

</Layout>
