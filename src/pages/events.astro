---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Events">

<style is:global>
  .container {
    max-width: 1000px;
    margin: 80px auto;
    padding: 0 20px;
    color: #ddd;
  }

  .container h1 {
    font-size: 28px;
    margin-bottom: 50px;
  }

  .event {
    display: flex;
    gap: 30px;
    margin-bottom: 70px;
    align-items: flex-start;
  }

  .poster {
    width: 200px;
    height: 280px;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .poster img {
    width: 200px;
    height: 280px;
    object-fit: contain;
    object-position: top center;
    display: block;
  }

  .info {
    font-size: 16px;
    line-height: 1.9;
  }

  .title {
    font-size: 18px;
    margin-bottom: 10px;
  }

  .work {
    margin-bottom: 6px;
  }

  .date {
    margin-bottom: 6px;
  }

  .pagination {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
    margin-bottom: 60px;
  }

  .page-button {
    border: 0;
    background: transparent;
    color: #888;
    font-family: inherit;
    font-size: 16px;
    cursor: pointer;
    padding: 5px;
  }

  .page-button:hover {
    color: white;
  }

  .page-button.active {
    color: white;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .event {
      flex-direction: column;
    }

    .poster {
      width: 200px;
      height: 280px;
    }

    .poster img {
      width: 200px;
      height: 280px;
    }
  }
</style>


<div class="container">

  <h1>EVENTS</h1>


  <!-- ==================================================
       PAGE 1
       가장 최근 페이지
       13 → 14 → 15 → 16
       ================================================== -->

  <div class="event" data-page="1">
    <div class="poster">
      <img src="/13.png" alt="Bachfeest Eisenach">
    </div>

