---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">

<style>
  .contact-container {
    max-width: 800px;
    margin: 80px auto;
    padding: 0 20px;
  }

  .contact-title {
    font-size: 36px;
    margin-bottom: 40px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-form input,
  .contact-form textarea {
    background: #111;
    border: 1px solid #333;
    color: white;
    padding: 16px;
    font-size: 16px;
    font-family: inherit;
  }

  .contact-form textarea {
    min-height: 250px;
    resize: vertical;
  }

  .contact-form button {
    background: white;
    color: black;
    border: none;
    padding: 16px;
    font-size: 16px;
    cursor: pointer;
  }

  .contact-form button:hover {
    opacity: 0.8;
  }
</style>

<div class="contact-container">

  <h1 class="contact-title">CONTACT</h1>

  <form
    class="contact-form"
    action="mailto:cmhunida@gmail.com"
    method="post"
    enctype="text/plain"
  >

    <input
      type="text"
      name="name"
      placeholder="Name"
      required
    />

    <input
      type="email"
      name="email"
      placeholder="Email"
      required
    />

    <textarea
      name="message"
      placeholder="Message"
      required
    ></textarea>

    <button type="submit">
      Send Message
    </button>

  </form>

</div>

</Layout>
