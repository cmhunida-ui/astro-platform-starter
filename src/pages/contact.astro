---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">

<style>
  .contact-container {
    max-width: 900px;
    margin: 80px auto;
    padding: 0 20px;
  }

  .contact-title {
    font-size: 36px;
    margin-bottom: 60px;
    letter-spacing: 2px;
  }

  .contact-item {
    margin-bottom: 40px;
  }

  .contact-label {
    font-size: 14px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 10px;
  }

  .contact-value {
    font-size: 22px;
    line-height: 1.8;
  }

  .contact-value a {
    color: white;
    text-decoration: none;
  }

  .contact-value a:hover {
    opacity: 0.7;
  }
</style>

<div class="contact-container">

  <h1 class="contact-title">CONTACT</h1>

  <div class="contact-item">
    <div class="contact-label">E-mail</div>
    <div class="contact-value">
      <a href="mailto:cmhunida@gmail.com">
        cmhunida@gmail.com
      </a>
    </div>
  </div>

  <div class="contact-item">
    <div class="contact-label">Instagram</div>
    <div class="contact-value">
      <a href="https://www.instagram.com/junghoon.n/" target="_blank">
        @junghoon.n
      </a>
    </div>
  </div>

</div>

</Layout>
